# Leave key/model empty for similarity-only search and keyword-only homework detection.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Optional: api, package or none. If omitted, API mode is inferred from credentials.
# LLM_MODE=api
# Optional transcript character budget; AI settings can override this too.
# LLM_MAX_INPUT_CHARS=12000
# Local AI settings in data/settings.json override these environment defaults.

# Anthropic: LLM_PROVIDER=anthropic; use an Anthropic API key and Claude model id.
# Legacy variables below are fallbacks only for Anthropic; LLM_* takes precedence.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI: LLM_PROVIDER=openai; set LLM_API_KEY to an OpenAI key and LLM_MODEL
# to a model id supporting the Responses API and JSON mode.

# Gemini: LLM_PROVIDER=gemini; set LLM_API_KEY to a Gemini Developer API key
# and LLM_MODEL to a Gemini model id supporting JSON responses.

# OpenRouter example (OpenAI-compatible Chat Completions):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=<your OpenRouter key>
# LLM_MODEL=<your chosen OpenRouter model id>
# Optional stronger model for one-time preprocessing; empty means use LLM_MODEL.
# LLM_MODEL_PREPROCESS=
# Follow-up chat policy: strict (course materials only) or labelled.
# LLM_CHAT_POLICY=strict
# For local Ollama use http://localhost:11434/v1; the key may be empty.
# For LM Studio use http://localhost:1234/v1; the key may be empty.
